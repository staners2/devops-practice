#cloud-config
${yamlencode({
  users = [{
    name                = ssh_user
    groups              = ["sudo"]
    sudo                = ["ALL=(ALL) NOPASSWD:ALL"]
    shell               = "/bin/bash"
    lock_passwd         = true
    ssh_authorized_keys = [ssh_public_key]
  }]
  ssh_pwauth   = false
  disable_root = true
})}
