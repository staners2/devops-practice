logging {
	level  = "info"
	format = "json"
}

discovery.kubernetes "pods" {
	role = "pod"

	namespaces {
		names = ["devops-practice", "platform", "argocd", "ingress-nginx", "gitlab-runner", "monitoring"]
	}

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + sys.env("NODE_NAME")
	}
}

discovery.relabel "pod_logs" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		action        = "keep"
		regex         = "devops-practice|platform|argocd|ingress-nginx|gitlab-runner|monitoring"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		action        = "keep"
		regex         = "(devops-practice|argocd|ingress-nginx|gitlab-runner|monitoring);.*|platform;(postgresql-patroni|postgresql-backup|postgresql-restore|postgresql|redis|kafka)"
	}

	rule {
		target_label = "cluster"
		replacement  = "devops-practice"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		regex         = "(.+)"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "component"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_component"]
		regex         = "(.+)"
		target_label  = "component"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}
}

loki.source.kubernetes "pod_logs" {
	targets    = discovery.relabel.pod_logs.output
	forward_to = [loki.process.pod_logs.receiver]
}

loki.process "pod_logs" {
	stage.json {
		expressions = {
			time  = "time",
			level = "level",
		}
	}

	stage.timestamp {
		source            = "time"
		format            = "RFC3339Nano"
		action_on_failure = "skip"
	}

	stage.template {
		source   = "level"
		template = "{{ if .Value }}{{ ToLower .Value }}{{ else }}unknown{{ end }}"
	}

	stage.labels {
		values = {level = ""}
	}

	stage.label_keep {
		values = ["cluster", "namespace", "app", "component", "pod", "container", "level"]
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki.monitoring.svc.cluster.local:3100/loki/api/v1/push"
	}
}
