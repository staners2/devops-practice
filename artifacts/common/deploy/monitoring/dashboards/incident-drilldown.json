  "annotations": {
    "list": [
      {
        "name": "Deployment: создание pod",
        "enable": true,
        "hide": false,
        "iconColor": "#5794F2",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "target": {
          "refId": "AnnoPod",
          "expr": "(kube_pod_created{cluster=\"devops-practice\",service=\"kube-state-metrics\",namespace=~\"$namespace\",pod=~\"devops-practice-.*\"} >= ${__from:date:seconds}) and (kube_pod_created{cluster=\"devops-practice\",service=\"kube-state-metrics\",namespace=~\"$namespace\",pod=~\"devops-practice-.*\"} <= ${__to:date:seconds})",
          "range": true,
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        "expr": "(kube_pod_created{cluster=\"devops-practice\",service=\"kube-state-metrics\",namespace=~\"$namespace\",pod=~\"devops-practice-.*\"} >= ${__from:date:seconds}) and (kube_pod_created{cluster=\"devops-practice\",service=\"kube-state-metrics\",namespace=~\"$namespace\",pod=~\"devops-practice-.*\"} <= ${__to:date:seconds})",
        "useValueForTime": true,
        "titleFormat": "Создан {{pod}}",
        "textFormat": "Namespace {{namespace}}; создание pod как маркер rollout",
        "tagKeys": "namespace,pod"
      },
      {
        "name": "Argo CD: изменение sync / health",
        "enable": true,
        "hide": false,
        "iconColor": "#FF9830",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "target": {
          "refId": "AnnoArgo",
          "expr": "argocd_app_info{cluster=\"devops-practice\",namespace=\"argocd\",service=\"argocd\",name=\"devops-practice\"} unless argocd_app_info{cluster=\"devops-practice\",namespace=\"argocd\",service=\"argocd\",name=\"devops-practice\"} offset 1m",
          "range": true,
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        "expr": "argocd_app_info{cluster=\"devops-practice\",namespace=\"argocd\",service=\"argocd\",name=\"devops-practice\"} unless argocd_app_info{cluster=\"devops-practice\",namespace=\"argocd\",service=\"argocd\",name=\"devops-practice\"} offset 1m",
        "titleFormat": "Argo CD: {{sync_status}} / {{health_status}}",
        "textFormat": "{{name}}; изменение набора labels app_info, точный timeline подтверждается Argo CD/Git",
        "tagKeys": "name,sync_status,health_status"
