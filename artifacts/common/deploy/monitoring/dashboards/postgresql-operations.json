{
  "uid": "postgresql-operations",
  "title": "PostgreSQL: эксплуатация и HA",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "devops-practice",
    "postgresql"
  ],
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(devops_practice_postgres_pool_max_connections, pod)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Активные alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "expr": "ALERTS{service=\"postgresql\",alertstate=\"firing\"}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Состояние exporter и БД",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "up{job=\"postgresql\"}",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "pg_up{job=\"postgresql\"}",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Primary и живые участники",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "postgresql:primary_count",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "postgresql:member_count",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Роли и timeline Patroni",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "patroni_primary{job=\"patroni\"}",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "patroni_replica{job=\"patroni\"}",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "patroni_postgres_timeline{job=\"patroni\"}",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Replay lag: байты",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "postgresql:replica_lag_bytes",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Соединения и лимит PostgreSQL",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "pg_stat_database_numbackends{job=\"postgresql\",datname=\"devops_practice\"}",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "pg_settings_max_connections{job=\"postgresql\"}",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Активность и блокировки",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (state) (pg_stat_activity_count{job=\"postgresql\",datname=\"devops_practice\"})",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (mode) (pg_locks_count{job=\"postgresql\",datname=\"devops_practice\"})",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Занятые и свободные соединения pool",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "devops_practice_postgres_pool_acquired_connections{pod=~\"$pod\"}",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "devops_practice_postgres_pool_idle_connections{pod=~\"$pod\"}",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "devops_practice_postgres_pool_max_connections{pod=~\"$pod\"}",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Ожидание и отмена acquire",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(devops_practice_postgres_pool_acquire_duration_seconds_total{pod=~\"$pod\"}[$__rate_interval])",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(devops_practice_postgres_pool_canceled_acquires_total{pod=~\"$pod\"}[$__rate_interval])",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Задержка API и обработка worker",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "devops_practice:http_latency_p95_seconds5m",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "devops_practice:worker_freshness_seconds",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Возраст backup и последняя ошибка",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "postgresql:backup_age_seconds",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "postgresql:latest_backup_failed",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Patroni targets и DCS heartbeat",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "up{job=\"patroni\"}",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "time() - patroni_dcs_last_seen{job=\"patroni\"}",
          "legendFormat": "{{pod}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Логи Patroni, backup и restore",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"platform\",app=~\"postgresql-patroni|postgresql-backup|postgresql-restore\"}"
        }
      ]
    }
  ]
}
