{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "imagePullSecrets", "auth", "storage", "resources", "patroni", "networkPolicy"],
  "properties": {
    "replicaCount": {"type": "integer", "enum": [3]},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9./:_-]*$"},
        "tag": {"type": "string", "pattern": "^[a-f0-9]{40}(@sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"type": "string", "enum": ["IfNotPresent", "Always", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {"name": {"$ref": "#/definitions/resourceName"}}
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret"],
      "properties": {"existingSecret": {"$ref": "#/definitions/resourceName"}}
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "size"],
      "properties": {
        "className": {"$ref": "#/definitions/resourceName"},
        "size": {"type": "string", "enum": ["2Gi"]}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resourceQuantities"},
        "limits": {"$ref": "#/definitions/resourceQuantities"}
      }
    },
    "patroni": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ttl", "loopWait", "retryTimeout", "maximumLagOnFailover"],
      "properties": {
        "ttl": {"type": "integer", "minimum": 20},
        "loopWait": {"type": "integer", "minimum": 1},
        "retryTimeout": {"type": "integer", "minimum": 3},
        "maximumLagOnFailover": {"type": "integer", "minimum": 0}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiServerCIDRs"],
      "properties": {
        "apiServerCIDRs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"}
        }
      }
    }
  },
  "definitions": {
    "resourceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "resourceQuantities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?m?$"},
        "memory": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi)$"}
      }
    }
  }
}
